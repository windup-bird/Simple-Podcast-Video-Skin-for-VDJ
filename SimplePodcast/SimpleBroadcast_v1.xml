<skin name="SimpleBroadcastVideoSkin" version="1" width="1920" height="1080"
			comment="A simple broadcast video skin" author="WindupBird" image="background.png" preview="preview.png">
  <copyright>Free for all to use</copyright>
  <font name="HarmonyOS Sans"/>

	<visual visibility="true">
		<pos x="0" y="0"/>
		<size width="1920" height="1080"/>
		<off x="0" y="0"/>
	</visual>

	<!-- Define the color here -->
	<define color = "text" value = "white"/>
	<define color = "title" value = "white"/>
	<define color = "artist" value = "lightgray"/>


	<!-- Next Track Info -->
	<group name="nexttrack" x="+1920-200-100" y="+500"
			visibility="not param_equal `deck master get_filename` `get_loaded_song 'filename' deck='master'`">

			<!-- Next Song -->
			<textzone>
				<pos x="+0" y="+0"/>
				<size width="200" height="50"/>
				<text fontsize="28" align="left" color="text" text="Play Next"/>
			</textzone>

			<!-- Cover -->
			<cover source="default">
				<pos x="+0" y="+50"/>
				<size width="200" height="200"/>
			</cover>

			<!-- Artist -->
			<textzone group="horizontal" scroll="yes" align="right">
				<pos x="-200" y="+50+200"/>
				<size width="400" height="50"/>
				<text fontsize="28" color="artist" weight="regular" action="get loaded_song artist"/>
			</textzone>

			<!-- Titile -->
			<textzone group="horizontal" scroll="yes" align="right" >
				<pos x="-200" y="+50+200+40"/>
				<size width="400" height="50"/>
				<text fontsize="28" color="title" weight="bold" action="get loaded_song title"/>
			</textzone>
	</group>

	<!-- Playing Now -->
	<group name="masterdeck" x="+100" y="+400">
		<deck deck="master">

			<!-- Playing Now -->
			<textzone>
				<pos x="+0" y="-5"/>
				<size width="400" height="50"/>
				<text fontsize="36" align="left" color="text" text="Playing Now"/>
			</textzone>

			<!-- Cover -->
			<cover x="+0" y="+50" width="300" height="300"
				visibility="true"/>

			<!-- Track artist -->
			<textzone group="horizontal" align="left" scroll="yes">
				<pos x="+0" y="+50+300"/>
				<size width="500" height="50"/>
				<text fontsize="36" color="artist" weight="regular" action="get_artist_before_feat"/>
				<text fontsize="36" color="artist" weight="light" action="get_featuring_after_artist"/>
			</textzone>

			<!-- Track title -->
			<textzone group="horizontal" align="left" scroll="yes">
				<pos x="+0" y="+50+300+50"/>
				<size width="500" height="50"/>
				<text fontsize="36" color="title" weight="bold" action="get_title"/>
			</textzone>
		</deck>

	</group>

	<blockwave deck="master" blocksize="6" zoom="4" color="lightgray"
			center="middle"> <pos x="0" y="+400+450+50" /> <size width="1920" height="150"/>
	</blockwave>

</skin>
